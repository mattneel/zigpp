#file=shape.zig
pub const Shape = union(enum) {
    circle: u32,
    priv square: u32,
    pub fn makeSquare(side: u32) Shape {
        return .{ .square = side };
    }
    pub fn area(s: Shape) u32 {
        return switch (s) {
            .circle => |r| 3 * r * r,
            .square => |side| side * side,
        };
    }
};
